{
  "component": "EpisodeStateCard",
  "version": "1.0.0-stable",
  "status": "API_STABILIZED",
  "stability_date": "2026-08-06T10:00:00Z",
  "react_version_min": "18.2",
  "forwarded_ref": {
    "type": "HTMLDivElement",
    "supported": true
  },
  "discriminated_union": {
    "discriminator": "variant",
    "members": [
      "EpisodeStateCardAvailableProps",
      "EpisodeStateCardUnavailableProps"
    ]
  },
  "props": {
    "shared": {
      "description": "Props shared by both available and unavailable variants",
      "fields": [
        {
          "name": "variant",
          "type": "EpisodeStateCardVariant",
          "required": true,
          "description": "Visual state discriminant",
          "valid_values": [
            "default",
            "blocked",
            "human-review-required",
            "approved",
            "published",
            "unavailable"
          ]
        },
        {
          "name": "reduceMotion",
          "type": "boolean",
          "required": false,
          "default": false,
          "description": "Override prefers-reduced-motion system setting (lab demo only)"
        },
        {
          "name": "className",
          "type": "string",
          "required": false,
          "description": "Tailwind CSS class override for root container"
        }
      ]
    },
    "available_only": {
      "description": "Props required for available variants (default, blocked, human-review-required, approved, published)",
      "canonical": [
        {
          "name": "channelName",
          "type": "string",
          "required": true,
          "description": "Channel name (e.g., 'Wealth Decoded')",
          "example": "Wealth Decoded"
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "description": "Episode title",
          "example": "Master Approved"
        },
        {
          "name": "workflowState",
          "type": "string",
          "required": true,
          "description": "Technical state identifier",
          "example": "MASTER_APPROVED"
        },
        {
          "name": "humanReviewStatus",
          "type": "HumanReviewStatus",
          "required": true,
          "description": "Current human review status",
          "valid_values": [
            "not-required",
            "required",
            "completed"
          ],
          "note": "unavailable status not allowed for available variants"
        }
      ],
      "presentation": [
        {
          "name": "episodeNumber",
          "type": "number | null",
          "required": false,
          "description": "Episode sequence number for display"
        },
        {
          "name": "workflowStateLabel",
          "type": "string",
          "required": false,
          "description": "Custom label for current workflow state (defaults to variant-based label)"
        },
        {
          "name": "lastDecision",
          "type": "EpisodeStateDecision | null",
          "required": false,
          "description": "Recent human decision and outcome"
        },
        {
          "name": "blockers",
          "type": "EpisodeStateBlocker[]",
          "required": false,
          "default": "[]",
          "description": "Critical/warning/info blocking conditions"
        },
        {
          "name": "nextExpectedState",
          "type": "string | null",
          "required": false,
          "description": "Next anticipated workflow state"
        },
        {
          "name": "nextAuthorizedAction",
          "type": "string | null",
          "required": false,
          "description": "Next human action required"
        },
        {
          "name": "youtubeVideoId",
          "type": "string",
          "required": false,
          "description": "YouTube video ID (published variant)",
          "example": "ASluRm71I8o"
        },
        {
          "name": "publishedAt",
          "type": "string",
          "required": false,
          "description": "ISO8601 publication timestamp",
          "example": "2026-08-05T02:06:47Z"
        },
        {
          "name": "canonicalSource",
          "type": "string",
          "required": false,
          "description": "Source system identifier",
          "example": "episode-013 manifest"
        },
        {
          "name": "manifestVersion",
          "type": "string",
          "required": false,
          "description": "Manifest schema version",
          "example": "1.1.0"
        }
      ]
    },
    "unavailable_only": {
      "description": "Props specific to unavailable variant",
      "fields": [
        {
          "name": "unavailableReason",
          "type": "string",
          "required": false,
          "description": "Technical reason for unavailable state",
          "example": "MANIFEST_FETCH_FAILED: upstream returned 404 for episode-014/manifest.json"
        }
      ]
    }
  },
  "exported_types": [
    {
      "name": "EpisodeStateCardProps",
      "kind": "type",
      "description": "Discriminated union of available and unavailable props",
      "is_public": true
    },
    {
      "name": "EpisodeStateCardAvailableProps",
      "kind": "interface",
      "description": "Props for available variants (default, blocked, human-review-required, approved, published)",
      "is_public": true
    },
    {
      "name": "EpisodeStateCardUnavailableProps",
      "kind": "interface",
      "description": "Props for unavailable variant",
      "is_public": true
    },
    {
      "name": "EpisodeStateCardVariant",
      "kind": "type",
      "description": "Union of visual variants",
      "values": [
        "default",
        "blocked",
        "human-review-required",
        "approved",
        "published",
        "unavailable"
      ],
      "is_public": true
    },
    {
      "name": "HumanReviewStatus",
      "kind": "type",
      "description": "Human review workflow state",
      "values": [
        "not-required",
        "required",
        "completed",
        "unavailable"
      ],
      "is_public": true
    },
    {
      "name": "EpisodeStateDecision",
      "kind": "interface",
      "description": "Human decision record",
      "fields": [
        {
          "name": "label",
          "type": "string",
          "required": true
        },
        {
          "name": "outcome",
          "type": "pass | pass-with-conditions | rework | stop",
          "required": false
        },
        {
          "name": "decidedAt",
          "type": "string",
          "required": false,
          "format": "ISO8601"
        },
        {
          "name": "decidedBy",
          "type": "string",
          "required": false
        }
      ],
      "is_public": true
    },
    {
      "name": "EpisodeStateBlocker",
      "kind": "interface",
      "description": "Blocking condition",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "required": true
        },
        {
          "name": "label",
          "type": "string",
          "required": true
        },
        {
          "name": "severity",
          "type": "info | warning | critical",
          "required": true
        }
      ],
      "is_public": true
    }
  ],
  "variant_invariants": {
    "default": {
      "description": "In-progress workflow state",
      "required_props": [
        "channelName",
        "title",
        "workflowState",
        "humanReviewStatus"
      ],
      "typical_props": [
        "episodeNumber",
        "lastDecision",
        "blockers",
        "nextAuthorizedAction"
      ],
      "forbidden_props": []
    },
    "blocked": {
      "description": "Workflow blocked by conditions",
      "required_props": [
        "channelName",
        "title",
        "workflowState",
        "humanReviewStatus"
      ],
      "typical_props": [
        "episodeNumber",
        "blockers",
        "nextAuthorizedAction"
      ],
      "forbidden_props": []
    },
    "human-review-required": {
      "description": "Awaiting human decision",
      "required_props": [
        "channelName",
        "title",
        "workflowState",
        "humanReviewStatus"
      ],
      "invariant": "humanReviewStatus must be 'required'",
      "typical_props": [
        "episodeNumber",
        "nextAuthorizedAction"
      ],
      "forbidden_props": []
    },
    "approved": {
      "description": "Decision approved, ready to proceed",
      "required_props": [
        "channelName",
        "title",
        "workflowState",
        "humanReviewStatus"
      ],
      "invariant": "humanReviewStatus must be 'completed'",
      "typical_props": [
        "episodeNumber",
        "lastDecision",
        "nextExpectedState"
      ],
      "forbidden_props": []
    },
    "published": {
      "description": "Episode live on YouTube",
      "required_props": [
        "channelName",
        "title",
        "workflowState",
        "humanReviewStatus"
      ],
      "invariant": "humanReviewStatus must be 'completed'",
      "typical_props": [
        "episodeNumber",
        "youtubeVideoId",
        "publishedAt",
        "nextExpectedState"
      ],
      "forbidden_props": []
    },
    "unavailable": {
      "description": "Manifest could not be loaded",
      "required_props": [],
      "optional_props": [
        "unavailableReason",
        "workflowState"
      ],
      "forbidden_props": [
        "channelName",
        "title",
        "episodeNumber",
        "humanReviewStatus",
        "lastDecision",
        "blockers",
        "nextExpectedState",
        "nextAuthorizedAction",
        "youtubeVideoId",
        "publishedAt",
        "canonicalSource",
        "manifestVersion"
      ]
    }
  },
  "removed_props": [
    {
      "name": "episodeId",
      "reason": "Never rendered or used for DOM IDs; superseded by React.useId()",
      "migration": "Remove from all call sites"
    },
    {
      "name": "updatedAt",
      "reason": "Dead prop; never displayed",
      "migration": "Remove from all call sites"
    }
  ],
  "accessibility": {
    "standard": "WCAG 2.2 AA",
    "features": [
      "Semantic region role with aria-labelledby",
      "Per-instance unique IDs (React.useId)",
      "Screen-reader-only severity labels",
      "Icon aria-hidden",
      "Respects prefers-reduced-motion",
      "7:1+ contrast on all text (AAA)"
    ],
    "review_decision": "PASS"
  },
  "styling": {
    "framework": "Tailwind CSS",
    "approach": "Utility-first, no CSS-in-JS",
    "responsive": true,
    "dark_mode": "Follows system prefers-color-scheme"
  },
  "performance": {
    "ref_forwarding": true,
    "memoization": false,
    "suspense": false,
    "lazy_loading": false
  },
  "backwards_compatibility": {
    "breaking_changes": true,
    "reason": "Removed episodeId and updatedAt; unavailable variant no longer accepts canonical props",
    "migration_guide": "docs/migrations/episode-state-card-experimental-to-stable.md",
    "previous_version": "0.1.0-experimental",
    "new_version": "1.0.0-stable"
  }
}
