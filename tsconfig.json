{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "tests/episode-state-card-api.test.ts",
    "tests/episode-state-card-accessibility.test.ts",
    "tests/adapters/episode-state-card-adapter.test.ts",
    "tests/youtube/episode-state-provider.test.ts",
    "tests/youtube/canonical-episode-to-snapshot.test.ts",
    "tests/youtube/get-episode-state-from-db.test.ts",
    "tests/youtube/cutover-readiness.test.ts",
    "tests/persistence/episode-repository.test.ts",
    "tests/persistence/episode-row-mappers.test.ts",
    "tests/persistence/episode-repository.live.test.ts"
  ]
}
